{
  "name": "larkling",
  "version": "0.1.0",
  "description": "IM-hosted personal agent runtime for Feishu (Lark)",
  "type": "module",
  "bin": {
    "larkling": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli/index.js start"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
